# Copy this file to .env and change the values. .env is never uploaded to git.
HOME_ENV=dev
HOME_API_TOKEN=change-me
HOME_MQTT_HOST=localhost
HOME_MQTT_PORT=1883
# Demo: raise the alert after 2 minutes of damp and warm air. Use 20 for a quick test.
HOME_MOLD_HOLD_SECONDS=120
# Only needed when you open the app in a browser during development:
# HOME_CORS_ORIGINS=["http://localhost:8081"]
